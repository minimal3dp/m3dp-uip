# M3DP-UIP Environment Variables Example
ENVIRONMENT=development
DEBUG=true
APP_NAME=M3DP-UIP

# Vision API (Gemini)
GOOGLE_GENAI_API_KEY=your_google_genai_api_key_here
GEMINI_MODEL=gemini-1.5-pro

# Amazon Product Advertising API (Phase 2)
PAAPI_ACCESS_KEY=
PAAPI_SECRET_KEY=
PAAPI_ASSOCIATE_TAG=mwf064-20

# Google Analytics
GA4_MEASUREMENT_ID=G-VQ8RPWC2MK

# Database (Future)
DATABASE_URL=

# File Upload Limits
MAX_UPLOAD_SIZE=10485760
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
# Application Environment Variables
# Copy this file to .env and fill in your actual values

# Environment
ENVIRONMENT=development
DEBUG=true

# Vision API (Gemini)
GOOGLE_GENAI_API_KEY=your_gemini_api_key_here

# Amazon Product API (PA-API) - Optional, Phase 2
PAAPI_ACCESS_KEY=your_paapi_access_key
PAAPI_SECRET_KEY=your_paapi_secret_key
PAAPI_ASSOCIATE_TAG=mwf064-20

# Google Analytics
GA4_MEASUREMENT_ID=G-VQ8RPWC2MK

# CORS Origins (comma-separated)
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173

